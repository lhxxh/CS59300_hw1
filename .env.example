# Copy to .env. Credentials are read by the server, never sent to the browser.
# OpenAI-compatible providers: OpenAI, DeepSeek, OpenRouter, etc.
LLM_API_STYLE=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# DeepSeek alternative:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# Azure Responses alternative (LLM_MODEL is your deployment name):
# LLM_API_STYLE=azure_responses
# LLM_BASE_URL=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
# LLM_MODEL=your-deployment-name
# LLM_API_KEY=your-azure-key
# LLM_MAX_OUTPUT_TOKENS=12000
# Optional, only for deployments that support reasoning effort:
# LLM_REASONING_EFFORT=low

# Ollama alternative (run `ollama pull qwen3:8b` first):
# LLM_API_STYLE=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

HOST=127.0.0.1
PORT=8000
# Use an absolute path to a persistent volume when deploying.
# DATA_DIR=/app/data
# Optional Crossref contact email for its polite API pool:
# CROSSREF_EMAIL=
# Optional HTTP Basic Auth for a publicly hosted single-user installation:
# APP_USERNAME=researcher
# APP_PASSWORD=choose-a-long-password
